     -->

    


    <!-- act_1 -->

    <owl:NamedIndividual rdf:about="http://ontologies.ef-ears.eu/ears2/1#act_1">
        <rdf:type rdf:resource="http://ontologies.ef-ears.eu/ears2/1#ProcessStep"/>
        <asConcept rdf:resource="http://ontologies.ef-ears.eu/ears2/1#concept_800"/>
    </owl:NamedIndividual>
    


    <!-- act_10 -->

    <owl:NamedIndividual rdf:about="http://ontologies.ef-ears.eu/ears2/1#act_10">
        <rdf:type rdf:resource="http://ontologies.ef-ears.eu/ears2/1#ProcessStep"/>
        <asConcept rdf:resource="http://ontologies.ef-ears.eu/ears2/1#concept_817"/>
    </owl:NamedIndividual>
    


    <!-- act_13 -->

    <owl:NamedIndividual rdf:about="http://ontologies.ef-ears.eu/ears2/1#act_13">
        <rdf:type rdf:resource="http://ontologies.ef-ears.eu/ears2/1#ProcessStep"/>
        <asConcept rdf:resource="http://ontologies.ef-ears.eu/ears2/1#concept_822"/>
    </owl:NamedIndividual>
    


    <!-- act_14 -->

    <owl:NamedIndividual rdf:about="http://ontologies.ef-ears.eu/ears2/1#act_14">
        <rdf:type rdf:resource="http://ontologies.ef-ears.eu/ears2/1#ProcessStep"/>
        <asConcept rdf:resource="http://ontologies.ef-ears.eu/ears2/1#concept_825"/>
    </owl:NamedIndividual>
    


    <!-- act_15 -->

    <owl:NamedIndividual rdf:about="http://ontologies.ef-ears.eu/ears2/1#act_15">
        <rdf:type rdf:resource="http://ontologies.ef-ears.eu/ears2/1#ProcessStep"/>
        <asConcept rdf:resource="http://ontologies.ef-ears.eu/ears2/1#concept_826"/>
    </owl:NamedIndividual>
    


    <!-- act_16 -->

    <owl:NamedIndividual rdf:about="http://ontologies.ef-ears.eu/ears2/1#act_16">
        <rdf:type rdf:resource="http://ontologies.ef-ears.eu/ears2/1#ProcessStep"/>
        <asConcept rdf:resource="http://ontologies.ef-ears.eu/ears2/1#concept_827"/>
