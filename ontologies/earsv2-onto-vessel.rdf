    <!-- &lt;http://vocab.nerc.ac.uk/collection/C17/current/11BU/&gt; -->

    <owl:NamedIndividual rdf:about="http://vocab.nerc.ac.uk/collection/C17/current/11BU/">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
